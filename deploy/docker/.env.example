# Copy to .env or let ./setup.sh generate it. Never commit the real file.

# Database password (setup.sh generates a random one).
POSTGRES_PASSWORD=change-me

# Host user that owns config/ and data/ (id -u, id -g).
ERVISIO_UID=1001
ERVISIO_GID=1001

# Where the host keeps repositories, Postgres and runner data.
ERVISIO_DATA_DIR=./data
# Admin socket shared with the Caddy plugin, mounted at /run/ervisio-repo.
ERVISIO_SOCKET_DIR=./run

# Published ports; keep BIND_ADDRESS on loopback behind a reverse proxy.
BIND_ADDRESS=127.0.0.1
APP_PORT=3400
SSH_PORT=2222

# Group id of /var/run/docker.sock, only for --profile runner.
DOCKER_GID=0

# Build metadata (optional).
ERVISIO_VERSION=dev
ERVISIO_COMMIT=unknown
