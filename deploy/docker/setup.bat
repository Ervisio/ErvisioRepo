@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

set "NONINT=0"
set "ADMIN_EMAIL="
set "URL="
set "ERVISIO="
:parse
if "%~1"=="" goto parsed
if /i "%~1"=="--non-interactive" ( set "NONINT=1" & shift & goto parse )
if /i "%~1"=="--admin-email" ( set "ADMIN_EMAIL=%~2" & shift & shift & goto parse )
if /i "%~1"=="--url" ( set "URL=%~2" & shift & shift & goto parse )
if /i "%~1"=="--ervisio" ( set "ERVISIO=%~2" & shift & shift & goto parse )
echo Unknown option: %~1
exit /b 2
:parsed

where docker >nul 2>nul
if errorlevel 1 (
  echo Install Docker Desktop with Linux containers and try again.
  exit /b 1
)
docker compose version >nul 2>nul
if errorlevel 1 exit /b 1
docker info >nul 2>nul
if errorlevel 1 (
  echo Start Docker Desktop and try again.
  exit /b 1
)

if "%URL%"=="" (
  if "%NONINT%"=="1" ( set "URL=http://localhost:3400" ) else (
    set /p "URL=Public URL [http://localhost:3400]: "
    if "!URL!"=="" set "URL=http://localhost:3400"
  )
)
if "%ERVISIO%"=="" set "ERVISIO=no"
if /i not "%ERVISIO%"=="yes" if /i not "%ERVISIO%"=="no" (
  echo --ervisio must be yes or no
  exit /b 2
)

if not exist config mkdir config
if not exist data\postgres mkdir data\postgres
if not exist data\repo mkdir data\repo
if not exist data\runner mkdir data\runner
if not exist run mkdir run

rem Secrets are generated inside a throwaway container; nothing is installed on the host.
if not exist config\master.key (
  docker run --rm -v "%cd%\config:/out" alpine:3.22 sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /out/master.key && chmod 600 /out/master.key"
  if errorlevel 1 exit /b 1
  echo Created config\master.key: back it up somewhere safe.
)

if not exist .env (
  for /f %%P in ('docker run --rm alpine:3.22 sh -c "head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'"') do set "PGPASS=%%P"
  (
    echo POSTGRES_PASSWORD=!PGPASS!
    echo ERVISIO_UID=1001
    echo ERVISIO_GID=1001
    echo ERVISIO_DATA_DIR=./data
    echo ERVISIO_SOCKET_DIR=./run
    echo BIND_ADDRESS=127.0.0.1
    echo APP_PORT=3400
    echo SSH_PORT=2222
    echo DOCKER_GID=0
  ) > .env
)

set "SOCK="
if /i "%ERVISIO%"=="yes" set "SOCK=/run/ervisio-repo/plugin.sock"

if not exist config\config.toml (
  (
    echo # Generated by setup.bat. Any key can be overridden with EREPO_^<SECTION^>_^<KEY^>.
    echo [server]
    echo public_url = "%URL%"
    echo listen = "0.0.0.0:3400"
    echo ssh_listen = "0.0.0.0:2222"
    echo plugin_socket = "!SOCK!"
    echo.
    echo [security]
    echo master_key_file = "/etc/ervisio-repo/master.key"
    echo registration = "invite"
    echo.
    echo [log]
    echo level = "info"
    echo format = "json"
    echo.
    echo [[storage.target]]
    echo name = "hot"
    echo kind = "local"
    echo path = "/var/lib/ervisio-repo/data"
    echo budget = "50GB"
    echo.
    echo [storage.policy.git]
    echo primary = "hot"
  ) > config\config.toml
  echo Created config\config.toml.
)

docker compose up -d --build --wait --wait-timeout 180
if errorlevel 1 exit /b 1

echo.
echo Ervisio Repo is running at %URL%
echo   1. Open the URL and register: the first account becomes the administrator.
if not "%ADMIN_EMAIL%"=="" echo      Use %ADMIN_EMAIL% for that account.
echo   2. Behind Caddy: ervisio-repo caddy setup --host ^<your-domain^> (see docs\install.md).
echo   3. Stop with: docker compose stop. Optional: --profile runner, --profile backup.
endlocal
