@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

set "NONINT=0"
set "ADMIN_EMAIL="
set "URL="
set "ERVISIO="
set "RUNNER="
:parse
if "%~1"=="" goto parsed
if /i "%~1"=="--non-interactive" ( set "NONINT=1" & shift & goto parse )
if /i "%~1"=="--admin-email" ( set "ADMIN_EMAIL=%~2" & shift & shift & goto parse )
if /i "%~1"=="--url" ( set "URL=%~2" & shift & shift & goto parse )
if /i "%~1"=="--ervisio" ( set "ERVISIO=%~2" & shift & shift & goto parse )
if /i "%~1"=="--runner" ( set "RUNNER=%~2" & shift & shift & goto parse )
echo Unknown option: %~1
exit /b 2
:parsed

where docker >nul 2>nul
if errorlevel 1 (
  echo Install Docker Desktop with Linux containers and try again.
  exit /b 1
)
docker compose version >nul 2>nul
if errorlevel 1 exit /b 1
docker info >nul 2>nul
if errorlevel 1 (
  echo Start Docker Desktop and try again.
  exit /b 1
)

if "%URL%"=="" (
  if "%NONINT%"=="1" ( set "URL=http://localhost:3400" ) else (
    set /p "URL=Public URL [http://localhost:3400]: "
    if "!URL!"=="" set "URL=http://localhost:3400"
  )
)
if "%ERVISIO%"=="" set "ERVISIO=no"
if /i not "%ERVISIO%"=="yes" if /i not "%ERVISIO%"=="no" (
  echo --ervisio must be yes or no
  exit /b 2
)
rem Built-in Actions runner (compose profile "runner"): jobs run in Docker
rem containers through the Docker Desktop socket.
if "%RUNNER%"=="" (
  if "%NONINT%"=="1" ( set "RUNNER=yes" ) else (
    set /p "RUNNER=Start the built-in Actions runner (jobs run in Docker containers) (yes/no) [yes]: "
    if "!RUNNER!"=="" set "RUNNER=yes"
  )
)
if /i not "%RUNNER%"=="yes" if /i not "%RUNNER%"=="no" (
  echo --runner must be yes or no
  exit /b 2
)

if not exist config mkdir config
if not exist data\postgres mkdir data\postgres
if not exist data\repo mkdir data\repo
if not exist data\runner mkdir data\runner
if not exist run mkdir run

rem Secrets are generated inside a throwaway container; nothing is installed on the host.
if not exist config\master.key (
  docker run --rm -v "%cd%\config:/out" alpine:3.22 sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /out/master.key && chmod 600 /out/master.key"
  if errorlevel 1 exit /b 1
  echo Created config\master.key: back it up somewhere safe.
)

rem With the Ervisio Console plugin the socket must sit where the plugin looks for it
rem (a path inside the Docker Desktop VM).
set "SOCKDIR=./run"
if /i "%ERVISIO%"=="yes" set "SOCKDIR=/run/ervisio-repo"

if not exist .env (
  for /f %%P in ('docker run --rm alpine:3.22 sh -c "head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'"') do set "PGPASS=%%P"
  (
    echo POSTGRES_PASSWORD=!PGPASS!
    echo ERVISIO_UID=1001
    echo ERVISIO_GID=1001
    echo ERVISIO_DATA_DIR=./data
    echo ERVISIO_SOCKET_DIR=!SOCKDIR!
    echo BIND_ADDRESS=127.0.0.1
    echo APP_PORT=3400
    echo SSH_PORT=2222
    echo DOCKER_GID=0
  ) > .env
  rem COMPOSE_PROFILES makes a plain "docker compose up" include the runner.
  if /i "!RUNNER!"=="yes" echo COMPOSE_PROFILES=runner>> .env
)

set "SOCK="
if /i "%ERVISIO%"=="yes" set "SOCK=/run/ervisio-repo/api.sock"

if not exist config\config.toml (
  (
    echo # Generated by setup.bat. Any key can be overridden with EREPO_^<SECTION^>_^<KEY^>.
    echo [server]
    echo public_url = "%URL%"
    echo listen = "0.0.0.0:3400"
    echo ssh_listen = "0.0.0.0:2222"
    echo plugin_socket = "!SOCK!"
    echo.
    echo [security]
    echo master_key_file = "/etc/ervisio-repo/master.key"
    echo registration = "invite"
    echo.
    echo [log]
    echo level = "info"
    echo format = "json"
    echo.
    echo [[storage.target]]
    echo name = "hot"
    echo kind = "local"
    echo path = "/var/lib/ervisio-repo/data"
    echo budget = "50GB"
    echo.
    echo [storage.policy.git]
    echo primary = "hot"
    echo.
    echo [storage.policy.actions]
    echo primary = "hot"
  ) > config\config.toml
  echo Created config\config.toml.
)

rem Use the published image; if it cannot be pulled, build it from this checkout
rem so a stale local image is never started by mistake.
docker compose pull --quiet app
if errorlevel 1 (
  echo Could not pull the published image, building it from this checkout.
  docker compose build app
  if errorlevel 1 exit /b 1
)
docker compose up -d --wait --wait-timeout 300 postgres app
if errorlevel 1 exit /b 1

rem Built-in runner: the server CLI mints an instance registration token into
rem a file the runner reads on its first start and deletes after registering.
set "PROFILE="
if /i "%RUNNER%"=="yes" (
  set "PROFILE=--profile runner"
  if exist data\runner\.runner (
    echo The built-in runner is already registered ^(data\runner\.runner^).
  ) else (
    docker compose exec -T app ervisio-repo actions runner-token --scope instance --config /etc/ervisio-repo/config.toml > data\runner\registration-token
    if errorlevel 1 exit /b 1
    echo Created a registration token for the built-in runner.
  )
)
docker compose !PROFILE! up -d --wait --wait-timeout 300
if errorlevel 1 exit /b 1

echo.
echo Ervisio Repo is running at %URL%
echo   1. Open the URL and register: the first account becomes the administrator.
if not "%ADMIN_EMAIL%"=="" echo      Use %ADMIN_EMAIL% for that account.
echo   2. Behind Caddy: ervisio-repo caddy setup --host ^<your-domain^> (see docs\install.md).
if /i "%RUNNER%"=="yes" (
  echo   3. The built-in runner 'builtin' runs jobs for every repository ^(Admin ^> Runners^).
  echo      Add more machines from Admin ^> Runners ^> New runner.
) else (
  echo   3. Actions runner: re-run setup.bat --runner yes, or add one from Admin ^> Runners.
)
echo   4. Stop with: docker compose stop. Optional: --profile backup.
endlocal
