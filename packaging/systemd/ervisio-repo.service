[Unit]
Description=Ervisio Repo server
Documentation=https://github.com/Ervisio/ErvisioRepo
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ervisio-repo
Group=ervisio-repo
Slice=ervisio-repo.slice
ExecStart=/usr/lib/ervisio-repo/current/ervisio-repo serve --config /etc/ervisio-repo/config.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
LimitNOFILE=65536
RuntimeDirectory=ervisio-repo
RuntimeDirectoryMode=0750
StateDirectory=ervisio-repo
StateDirectoryMode=0750
ConfigurationDirectory=ervisio-repo

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/ervisio-repo

[Install]
WantedBy=multi-user.target
